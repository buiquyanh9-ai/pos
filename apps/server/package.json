{
  "name": "@shopflow/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "seed": "node src/seed.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "seed:demo": "node src/seed.ts --demo-sales",
    "create-owner": "node src/create-owner.ts",
    "backup": "node --env-file-if-exists=.env src/backup.ts",
    "import-menu": "node --env-file-if-exists=.env src/import-menu.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
