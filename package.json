{
  "name": "shopflow-pos-monorepo",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -k -n server,pos -c blue,green \"npm:dev:server\" \"npm:dev:pos\"",
    "dev:server": "npm run dev -w apps/server",
    "dev:pos": "npm run dev -w apps/pos",
    "build": "npm run build -w apps/pos",
    "typecheck": "npm run typecheck -w apps/server && npm run typecheck -w apps/pos",
    "test": "npm test -w apps/server && npm test -w apps/pos"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
